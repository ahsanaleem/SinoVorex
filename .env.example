# Contact form email settings.
# Copy this file to .env.local and fill in the password, then restart the dev server.
# On your hosting provider (Vercel, Hostinger, etc.) add the same variables in its environment settings.

# Mailbox the website logs in to and sends from (create it in Hostinger → Emails)
SMTP_USER=business@sinovorex.com
SMTP_PASS=

# Hostinger defaults — only change if you use a different mail provider
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Where enquiries are delivered
CONTACT_TO=business@sinovorex.com

# Public site address (canonical URLs, sitemap, link previews)
NEXT_PUBLIC_SITE_URL=https://sinovorex.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Plausible Analytics (cookie-free, no consent banner needed). Your site domain as registered in Plausible, e.g. sinovorex.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
